# Claude Agent SDK 0.2+ 使用非交互式 API 凭据，不使用本机 `claude /login`
# 的 Claude.ai 订阅登录。推荐在 Claude Console 创建 API Key：
ANTHROPIC_API_KEY=
# 官方 Anthropic API 请将 BASE_URL 留空；兼容网关再填写对应地址/模型。
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=
# ANTHROPIC_SMALL_FAST_MODEL=
# API_TIMEOUT_MS=300000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# CAS（Docker 见 quick-start.md；须挂载 docker/cas/services）
# AUTH_DISABLED=False
# CAS_SERVER_URL=http://localhost:3331/cas/
# CAS_SERVICE_URL=http://localhost:8000/api/v1/auth/callback
# FRONTEND_URL=http://localhost:3000/ai-eido/

# Project 共享资料累计配额（数量 / 字节）
# EIDO_PROJECT_MAX_FILES=100
# EIDO_PROJECT_MAX_BYTES=536870912
# EIDO_USER_PROJECT_MAX_FILES=500
# EIDO_USER_PROJECT_MAX_BYTES=2147483648

# 模型目录默认读取 backend/config/models.yaml；可覆盖为其它文件。
# CLAUDE_MODELS_FILE=/absolute/path/to/models.yaml
# models.yaml 可为每个模型分别引用以下 provider 环境变量。
GLM_BASE_URL=
GLM_API_KEY=
GLM_AUTH_TOKEN=
GLM_SMALL_FAST_MODEL=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_AUTH_TOKEN=
DEEPSEEK_SMALL_FAST_MODEL=
# ANTHROPIC_MODEL=sonnet
# CLAUDE_EFFORT=medium
# CLAUDE_COMPACT_PERCENT=80
# CLAUDE_SIMPLE_SYSTEM_PROMPT=true
# CLAUDE_DEFAULT_RUNTIME_MODE=qa
# CLAUDE_CLI_PATH=  # 默认使用 SDK 随附、已锁定版本的 CLI
