########################################################################
# Eido Docker Compose 环境变量
#
# 使用前复制本文件为 .env 并填写实际值：
#   cp docker/.env.example docker/.env
########################################################################

# ======================== Claude Code 模型 ========================
# 默认由 Claude Code 选择；自定义网关请配置实际支持的模型 ID。
# ANTHROPIC_MODEL=sonnet
# 模型目录已打包在 backend/config/models.yaml；自定义部署可覆盖路径。
# CLAUDE_MODELS_FILE=/app/config/models.yaml
# models.yaml 可为每个模型分别引用以下 provider 环境变量。
GLM_BASE_URL=
GLM_API_KEY=
GLM_AUTH_TOKEN=
GLM_SMALL_FAST_MODEL=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_AUTH_TOKEN=
DEEPSEEK_SMALL_FAST_MODEL=
# CLAUDE_EFFORT=medium
# CLAUDE_COMPACT_PERCENT=80
# CLAUDE_SIMPLE_SYSTEM_PROMPT=true
# CLAUDE_DEFAULT_RUNTIME_MODE=agent

# ======================== LLM 配置（三选一）========================

# --- Anthropic 官方 API（推荐用于 Claude Agent SDK）---
# 在 Claude Console 创建 API Key。不要填写 ANTHROPIC_BASE_URL。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=
# ANTHROPIC_SMALL_FAST_MODEL=

# --- MiniMax ---
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# ANTHROPIC_API_KEY=your_minimax_api_key
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=
# ANTHROPIC_SMALL_FAST_MODEL=

# --- DeepSeek ---
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=your_deepseek_api_key
# ANTHROPIC_MODEL=deepseek-chat
# ANTHROPIC_SMALL_FAST_MODEL=deepseek-chat
# API_TIMEOUT_MS=600000
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ======================== 端口与路径 =============================

# 宿主机端口（默认 80）
EIDO_PORT=80

# 宿主机 .claude 目录（包含 skills 等）
CLAUDE_DIR=~/.claude

# 日志目录（app/nginx 会自动创建子目录）
LOG_DIR=~/eido-logs

# ======================== 认证（可选）=============================
# 设为 False 并配合 --profile cas 启用 CAS 单点登录
AUTH_DISABLED=True
# 可选的用户 ID 白名单，逗号分隔；单租户公网部署应限制为自己的账号。
# AUTH_ALLOWED_USER_IDS=oauth_github_123456
# 可选：限制允许登录的 GitHub 账号（login，逗号分隔、大小写不敏感）；留空不限制。
# AUTH_ALLOWED_GITHUB_USERS=damaohongtu
# CAS_SERVER_URL=http://localhost:3331/cas/
# CAS_INTERNAL_URL=http://cas-server:8080/cas/
# CAS_SERVICE_URL=http://localhost:8000/api/v1/auth/callback
# FRONTEND_URL=http://localhost/ai-eido/
# 设置随机 SESSION_SECRET_KEY 后，登录用户可获取固定 API Key。
# SESSION_SECRET_KEY=
# GitHub OAuth App；本地回调地址需与 GitHub 应用设置完全一致。
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:19080/ai-eido/api/v1/auth/callback/github
# 其他 OIDC 提供方，详见 docs/authentication.md。
# OIDC_PROVIDERS_JSON=[]
#
# CAS 服务端口（默认 3331）
# CAS_PORT=3331
# CAS 测试用户（格式：user1::pwd1,user2::pwd2）
# CAS_USERS=casuser::Mellon,test1::123456,admin::admin123

# ======================== 沙箱多用户模式（profile=sandbox）===========
# 启用方式：
#   docker compose -f docker/docker-compose.yml --profile sandbox up -d
#
# 共享密钥（必填，gateway↔user 受信网关头校验，建议 32+ 字符随机串）
# EIDO_GATEWAY_SECRET=please-generate-a-long-random-string
#
# 是否信任受信网关头（X-Eido-User-Id + X-Eido-Gateway-Secret）。
# gateway 入口默认关闭受信身份头，使用登录会话、API Key 或任务 Token。
# 设为 1 后 gateway 也信任受信头；内置 nginx 已 strip 客户端入站这两个头，
# 因此外部公网仍无法伪造，只有 docker exec 进容器内部时可用（用于 smoke 测试 / 调度子进程）。
# EIDO_TRUST_GATEWAY=1
#
# user 容器镜像（gateway 通过 docker SDK 拉起）
# EIDO_USER_IMAGE=damaohongtu/eido-user:latest
#
# 闲置回收 TTL（秒），默认 15 min
# EIDO_SANDBOX_IDLE_TTL=900
# EIDO_SANDBOX_HEALTH_TTL=15
# EIDO_USER_TMPFS_SIZE=512m
#
# 单个 user 容器资源限额
# EIDO_USER_MEM=2g
# EIDO_USER_CPUS=1.0
# EIDO_USER_PIDS_LIMIT=500

# Project 共享资料累计配额（数量 / 字节）
# EIDO_PROJECT_MAX_FILES=100
# EIDO_PROJECT_MAX_BYTES=536870912
# EIDO_USER_PROJECT_MAX_FILES=500
# EIDO_USER_PROJECT_MAX_BYTES=2147483648

# 容器外网 DNS（eido / eido-gateway 解析上游 LLM 域名用；内网部署可换成公司 DNS）
# EIDO_DNS_1=223.5.5.5
# EIDO_DNS_2=114.114.114.114
