# 本地容器测试环境（sandbox + cas，CAS 用户 test1/123456）
# 用法: docker compose -f docker/docker-compose.yml --env-file docker/.env.local --profile sandbox --profile cas up -d

# LLM：gateway relay 直连智谱
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_API_KEY=ae5ae4cad5f346f0866746d158faf3bf.ccWG2Y0WsisOTzdr
ANTHROPIC_MODEL=glm-5.1
ANTHROPIC_SMALL_FAST_MODEL=glm-5.1

# 端口：8088 避免与本机 80 冲突
EIDO_PORT=8088

# 宿主机目录
CLAUDE_DIR=/Users/mao/.claude
LOG_DIR=/Users/mao/eido-logs

# CAS：容器内经宿主机 LAN IP 访问 cas-server，浏览器经 localhost:8088 回调
AUTH_DISABLED=False
CAS_SERVER_URL=http://192.168.138.122:3331/cas/
CAS_SERVICE_URL=http://localhost:8088/ai-eido/api/v1/auth/callback
FRONTEND_URL=http://localhost:8088/ai-eido/

SESSION_SECRET_KEY=6326004eb8869a1e60d9c9d4564d67c2dae88e898abf5e8a6b56bd94a6ae33cb
EIDO_GATEWAY_SECRET=4ccbe8223088fa18a2e75fb3c9799949f2a3e92b3dcbe11ef15c859f5f5f977d

EIDO_USER_IMAGE=damaohongtu/eido-user:latest
EIDO_USER_MEM=2g
EIDO_USER_CPUS=1.0
EIDO_SANDBOX_IDLE_TTL=1800
EIDO_ADMIN_USERS=admin
