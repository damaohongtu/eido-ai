{
  "manifest_version": 3,
  "name": "Eido 网页分析助手",
  "description": "在浏览器右侧打开 Eido，读取当前网页或其他标签页内容并交给技能工作流分析。",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "打开 Eido"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
