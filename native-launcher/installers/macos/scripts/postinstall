#!/bin/zsh
set -euo pipefail

# Version 0.1.0/0.1.1 used a path that Chrome does not scan for system hosts.
rm -f "/Library/Application Support/Google/Chrome/NativeMessagingHosts/ai.eido.opencode_launcher.json"

# A user-scoped development manifest takes precedence over the system manifest.
# Remove only Eido's known development registration for the interactive user.
CONSOLE_USER="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" && "$CONSOLE_USER" != "loginwindow" ]]; then
  USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || true)"
  if [[ -n "$USER_HOME" ]]; then
    rm -f "$USER_HOME/Library/Application Support/Google/Chrome/NativeMessagingHosts/ai.eido.opencode_launcher.json"
    rm -f "$USER_HOME/Library/Application Support/Eido/bin/eido-opencode-launcher"
  fi
fi

exit 0
